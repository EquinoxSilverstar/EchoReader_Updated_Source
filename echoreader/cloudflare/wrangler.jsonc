{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "echoreader-voices",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "FIREBASE_PROJECT_ID": "echo-reader-39cec"
  },
  "durable_objects": {
    "bindings": [{ "name": "USAGE", "class_name": "UsageBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageBudget"] }]
}
