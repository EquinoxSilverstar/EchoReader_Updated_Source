# Copy to .env.local. These are PUBLIC Firebase web app configuration values.
# Get them from Firebase Console -> Project Settings -> Your apps -> Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Optional public HTTPS endpoint of the *deployed* authenticated Cloudflare Worker.
# Do NOT put ElevenLabs/Google cloud TTS private API keys here.
# EXPO_PUBLIC_TTS_PROXY_URL=https://echoreader-voices.YOUR_SUBDOMAIN.workers.dev
